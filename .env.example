CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_ENDPOINT=http://clickhouse:8123
CLICKHOUSE_DATABASE=security
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

NATS_URL=nats://nats:4222
NATS_SUBJECT=security.events
NATS_STREAM=HAYABUSA_EVENTS
NATS_CONSUMER=HAYABUSA_INGEST

API_PORT=8080
WEB_PORT=3000

# Host exposure. Management/data-plane services bind to loopback in Compose.
# Collector ingress is loopback by default. For a remote collector, copy this file to .env and bind only the trusted LAN interface/IP that the collector must reach.
HAYABUSA_NATS_BIND=127.0.0.1
HAYABUSA_SYSLOG_BIND=127.0.0.1
HAYABUSA_LEGACY_WINDOWS_BIND=127.0.0.1
HAYABUSA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
